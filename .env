# Environment configuration for GCP GenAI Security Setup
# Copy this file and update with your actual values

# GCP Project ID (required)
GCP_PROJECT_ID=agentic-fortress


# GCP Project Number (optional - will be fetched if not set)
GCP_PROJECT_NUMBER=467809380317

# Cloud Storage bucket name (must be globally unique)
BUCKET_NAME=agentic-fortress-genai-data-bucket

# GCP region/location for resources
LOCATION=us-east1

# Service account name (used for IAM)
SERVICE_ACCOUNT_NAME=llm-training-sa

# KMS keyring and key names for CMEK encryption
KEYRING_ID=llm-keyring
KEY_ID=llm-training-key

# VPC network name for firewalls
VPC_NETWORK=genai-vpc

# Optional: Trusted IP range for additional firewall rules
TRUSTED_IP_RANGE=203.0.113.0/24

# AWS Bedrock Configuration
AWS_REGION=us-east-1

# Azure AI Configuration
AZURE_REGION=eastus
